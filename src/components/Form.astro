---
import { actions } from "astro:actions";

type Props = {
  language?: "de" | "en";
};

const { language } = Astro.props as Props;

const lang: "de" | "en" = language ?? Astro.locals.lang ?? "en";

// const { lang } = Astro.locals;

const labels =
  lang === "de"
    ? {
        notcoming: "Komme leider nicht",
        coming: "Ich/Wir kommen!",
        name: "Name",
        amount: "Anzahl Leute",
        diet: "Was gibts zum Abendessen?",
        diet_norm: "Fisch & Fleisch",
        diet_veggie: "vegetarisch",
        diet_vegan: "vegan",
        comment: "Kommentar",
        send: "Senden",
        dietOptions: {
          none: "Keine",
          veggie: "Vegetarisch",
          vegan: "Vegan",
          other: "Andere",
        },
      }
    : {
        notcoming: "Can't make it",
        coming: "Coming",
        name: "Name",
        amount: "Number of guests",
        diet: "What's for dinner?",
        diet_norm: "Meat & Fish",
        diet_veggie: "vegetarian",
        diet_vegan: "vegan",
        comment: "Comment",
        send: "Send",
        dietOptions: {
          none: "None",
          veggie: "Vegetarian",
          vegan: "Vegan",
          other: "Other",
        },
      };
---

<form
  method="post"
  action={actions.submitForm}
  class="fancy-form"
  data-attendance-form={language}
>
  <label class="checkbox-row">
    <span>{labels.notcoming}</span>
    <input name="notcoming" type="checkbox" id={`cb_notcoming-${language}`} />
  </label>

  <div class="line-form"></div>

  <label class="checkbox-row">
    <span>{labels.coming}</span>
    <input name="coming" type="checkbox" id={`cb_coming-${language}`} />
  </label>

  <label>
    <span>{labels.name}</span>
    <input
      type="text"
      name="name"
      required
      maxlength="255"
      placeholder={labels.name}
    />
  </label>

  <label>
    <span>{labels.amount}</span>
    <input type="number" name="amount" min="0" max="99" value="0" required />
  </label>

  <p class="form-fullrow form-note">
    {labels.diet}
  </p>

  <label>
    <span>{labels.diet_norm}</span>
    <input type="number" name="diet_norm" min="0" max="99" value="0" required />
  </label>

  <label>
    <span>{labels.diet_veggie}</span>
    <input
      type="number"
      name="diet_veggie"
      min="0"
      max="99"
      value="0"
      required
    />
  </label>

  <label>
    <span>{labels.diet_vegan}</span>
    <input
      type="number"
      name="diet_vegan"
      min="0"
      max="99"
      value="0"
      required
    />
  </label>

  <!-- <label>
    <span>{labels.diet}</span>
    <select name="diet" required>
      <option value="none">{labels.dietOptions.none}</option>
      <option value="veggie">{labels.dietOptions.veggie}</option>
      <option value="vegan">{labels.dietOptions.vegan}</option>
      <option value="other">{labels.dietOptions.other}</option>
    </select>
  </label> -->

  <label class="textarea-label">
    <span>{labels.comment}</span>
    <textarea name="comment" maxlength="200"></textarea>
  </label>

  <button type="submit" class="submit-btn">{labels.send}</button>
</form>

<style is:global>
  .fancy-form {
    display: grid;
    grid-template-columns: 2fr 3fr;
    gap: 1rem 0.8rem;
    width: 80%;
    max-width: 450px; /* schöne, schmale Form */
    margin: 1.5rem auto;
  }

  .fancy-form label {
    display: contents; /* labels und inputs automatisch in Grid verteilt */
  }

  .fancy-form label span {
    font-weight: 500;
    align-self: center;
  }

  .fancy-form input,
  .fancy-form select,
  .fancy-form textarea {
    padding: 0.4rem;
    border: 1px solid #aaa;
    border-radius: 4px;
    font-size: 1rem;
    width: 100%;
  }

  .fancy-form textarea {
    min-height: 80px;
    resize: vertical;
    grid-column: span 2; /* Kommentar nimmt volle Breite ein */
  }

  .fancy-form .textarea-label span {
    grid-column: 1 / -1; /* Kommentar-Label ebenfalls volle Breite */
  }

  .fancy-form button {
    grid-column: span 2;
    padding: 0.6rem;
    background-color: rgb(2, 189, 111);
    color: white;
    border: none;
    border-radius: 6px;
    font-weight: bold;
    cursor: pointer;
  }

  .fancy-form button:hover {
    opacity: 0.9;
  }

  .line-form {
    grid-column: span 2;
    width: 100%; /* % of parent element */
    height: 1px; /* thickness */
    background: rgb(105, 114, 110); /* color */
    margin: 0.5rem auto; /* center horizontally */
  }

  /* Full-width row inside the grid (must be a direct child of .fancy-form) */
  .fancy-form > .form-fullrow {
    grid-column: 1 / -1; /* span both columns */
  }

  /* Optional styling for the text */
  .fancy-form > .form-note {
    font-weight: bold;
    font-size: 1rem;
    /* font-size: 0.95rem; */
    line-height: 1.35;
    /* color: var(--dark-green); */
    /* opacity: 0.9; */
    margin: 0.2rem 0 0.6rem;
  }
</style>
