---
// Layout.astro
// This layout wraps around all pages that use it

const { title = "Wedding Announcement" } = Astro.props;

const { lang, isGerman } = Astro.locals;
const currentLang: "en" | "de" = lang ?? "en";
---

<!doctype html>
<html lang={currentLang} data-lang={currentLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <!-- Global styles and color variables -->
    <style is:global>
      @font-face {
        font-family: "Kante";
        src: url("fonts/Kante-Regular-Trial.woff2") format("woff2");
        font-weight: 400; /* Regular */
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: "Kante";
        src: url("fonts/Kante-Medium-Trial.woff2") format("woff2");
        font-weight: 500; /* Medium */
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: "Kante";
        src: url("fonts/Kante-SemiBold-Trial.woff2") format("woff2");
        font-weight: 600; /* SemiBold */
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: "Kante";
        src: url("fonts/Kante-Bold-Trial.woff2") format("woff2");
        font-weight: 700; /* Bold */
        font-style: normal;
        font-display: swap;
      }

      @font-face {
        font-family: "Kante";
        src: url("fonts/Kante-Italic-Trial.woff2") format("woff2");
        font-weight: 400; /* Italic is usually tied to the same weight as Regular unless you have more italic files */
        font-style: italic;
        font-display: swap;
      }

      :root {
        --mint-green: #77bb77;
        --light-grey: #b1b1b1bd;
        --dark-green: #013220;
        font-family: "Kante";
      }

      /* *START: Parallax background style* */
      .parallax-bg {
        position: fixed;
        top: -40%;
        left: 0;
        width: 100%;
        height: 200svh;
        background-image: url("/background.jpeg");
        background-size: cover;
        background-repeat: no-repeat;
        background-position: left center;
        z-index: -1;
        will-change: transform;
      }
      /* *END: Parallax background style* */

      body {
        margin: 0;
        padding: 0;
        /* background: url("/background.jpeg") no-repeat center center fixed; */
        /*background-size: cover;*/ /* 🧷 Ensures image covers full screen */
        display: flex;
        justify-content: center;
        min-height: 100vh;
        font-family: "Kante";
      }

      header {
        display: flex;
        justify-content: flex-end;
        padding: 1rem;
        background-color: var(--light-green);
        border-top-left-radius: 10px;
        border-top-right-radius: 10px;
      }

      .lang-switch a {
        margin-left: 1rem;
        text-decoration: none;
        font-weight: bold;
        color: #333;
      }

      main {
        background-color: var(
          --light-grey
        ); /* 🧊 Semi-transparent light grey */
        color: var(--dark-green); /* 💬 Mint green text inside the box */
        border-radius: 12px;
        padding: 1rem;
        max-width: 550px;
        /* width: 100%; */
        margin: 2rem 1rem;
        box-sizing: border-box;
      }

      /* Ensure proper spacing on small screens */
      @media (max-width: 600px) {
        main {
          margin: 1rem;
          padding: 1.5rem;
        }
      }

      h1 {
        text-align: center !important;
      }

      p {
        margin: 0.25rem !important;
      }

      p.tight {
        margin: 0.1rem !important;
      }

      .info-block-center {
        display: flex;
        flex-direction: column;
        margin-top: 2rem;
        width: 100%;
        text-align: justify;
        margin-right: auto;
      }

      .info-block-center p.header {
        font-weight: bold;
        text-align: center;
      }

      .info-block-left {
        display: flex;
        flex-direction: column;
        margin-top: 2rem;
        width: 80%;
        text-align: justify;
        margin-right: auto;
      }

      .info-block-left p.header {
        font-weight: bold;
        text-align: left;
      }

      .info-block-right {
        display: flex;
        flex-direction: column;
        margin-top: 2rem;
        width: 80%;
        text-align: justify;
        margin-left: auto;
      }

      .info-block-right p.header {
        font-weight: bold;
        text-align: right;
      }

      .clean-table {
        width: 100%;
        border-collapse: collapse;
      }

      .clean-table td {
        padding: 0.3rem 0;
        border: none; /* keine Linien */
        text-align: left; /* bei right-block kann man right setzen */
        vertical-align: top;
      }

      .info-item {
        display: grid;
        grid-template-columns: auto max-content 1fr;
        gap: 0.75rem 1rem;
        align-items: baseline;
      }
      /* Icon styling */
      .icon {
        width: 24px;
        height: 24px;
        flex-shrink: 0;
        position: relative;
        top: 0.38em;
      }
      /* Responsive switch at 400px */
      @media (max-width: 500px) {
        .info-item {
          grid-template-columns: auto 1fr; /* 2 columns: icon + label */
          grid-template-rows: auto auto; /* allow row wrapping */
        }

        .text-cell {
          grid-column: 1 / span 2; /* move text to full width below */
        }
        .label-cell {
          text-align: left; /* Override right alignment for small screens */
        }
      }

      .line {
        width: 90%; /* % of parent element */
        height: 3px; /* thickness */
        background: rgb(5, 114, 69); /* color */
        margin: 0.5rem auto; /* center horizontally */
      }

      .line {
        width: 90%; /* % of parent element */
        height: 3px; /* thickness */
        background: rgb(5, 114, 69); /* color */
        margin: 0.5rem auto; /* center horizontally */
      }

      /* dynamical language handling */
      html[data-lang="en"] [data-lang-text="de"] {
        display: none;
      }

      html[data-lang="de"] [data-lang-text="en"] {
        display: none;
      }
    </style>
  </head>

  <body>
    <!-- *START: Parallax background div* -->
    <div class="parallax-bg"></div>
    <!-- *END: Parallax background div* -->
    <main>
      <header>
        <!-- 🧭 Language switch links at the top -->
        <button
          type="button"
          data-lang-btn="en"
          class={currentLang === "en" ? "active" : ""}
        >
          English
        </button>
        <button
          type="button"
          data-lang-btn="de"
          class={currentLang === "de" ? "active" : ""}
        >
          Deutsch
        </button>
      </header>

      <!-- 📄 Main content injected here -->
      <slot />
    </main>
    <!-- *START: Parallax scroll script* -->
    <script>
      const speed = -0.2;

      window.addEventListener("scroll", () => {
        const offset = window.scrollY;
        const bg = document.querySelector(".parallax-bg") as HTMLElement;
        if (bg) {
          bg.style.transform = `translateY(${offset * speed}px)`;
        }
      });
      (() => {
        const root = document.documentElement;

        function setLang(lang: string | null | undefined) {
          if (lang !== "de" && lang !== "en") return;
          root.dataset.lang = lang;
          root.setAttribute("lang", lang);

          // cookie for server + future page loads
          document.cookie = "lang=" + lang + ";path=/;SameSite=Lax";

          // simple active state
          document.querySelectorAll("[data-lang-btn]").forEach((btn) => {
            btn.classList.toggle(
              "active",
              btn.getAttribute("data-lang-btn") === lang
            );
          });
        }

        // initial from data-lang (set by Astro.locals.lang in SSR)
        setLang(root.dataset.lang);

        document.querySelectorAll("[data-lang-btn]").forEach((btn) => {
          btn.addEventListener("click", () => {
            const lang = btn.getAttribute("data-lang-btn");
            setLang(lang);
          });
        });
      })();
    </script>
    <!-- *END: Parallax scroll script* -->

    <script type="module">
      // Find every form instance that participates (you have 2: de + en)
      document
        .querySelectorAll("form[data-attendance-form]")
        .forEach((form) => {
          // Avoid double-binding if Astro re-renders parts during dev/hot reload
          if (form.dataset.exclusiveInit === "1") return;
          form.dataset.exclusiveInit = "1";

          const language = form.dataset.attendanceForm; // "de" or "en"

          const coming = document.getElementById(`cb_coming-${language}`);
          const notcoming = document.getElementById(`cb_notcoming-${language}`);

          if (!coming || !notcoming) return;

          const sync = () => {
            if (coming.checked) {
              notcoming.checked = false;
              notcoming.disabled = true;
              coming.disabled = false;
            } else if (notcoming.checked) {
              coming.checked = false;
              coming.disabled = true;
              notcoming.disabled = false;
            } else {
              coming.disabled = false;
              notcoming.disabled = false;
            }
          };

          coming.addEventListener("change", sync);
          notcoming.addEventListener("change", sync);
          sync(); // handle back-button / cached form state

          // --- NEW: require at least one choice ---
          const anyChecked = coming.checked || notcoming.checked;

          // Important: only require ONE of them, otherwise the browser demands BOTH.
          // Pick "coming" as the required anchor (could be either).
          coming.required = !anyChecked;
          notcoming.required = false;
        });
    </script>
  </body>
</html>
